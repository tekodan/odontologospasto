---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.published);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <!-- Hero image -->
  <div class="h-48 md:h-72 overflow-hidden bg-gray-200">
    {post.data.image ? (
      <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
    ) : (
      <div class="w-full h-full bg-gradient-to-r from-primary to-primary-light flex items-center justify-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white px-4 text-center">{post.data.title}</h1>
      </div>
    )}
  </div>

  <!-- Breadcrumb -->
  <div class="bg-bg-light border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
        <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-primary font-medium truncate max-w-[200px]">{post.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Article -->
  <article class="max-w-3xl mx-auto px-4 py-12">
    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-gray-400 mb-4">
        <span>{post.data.author}</span>
        <span>·</span>
        <span>{post.data.date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-text-dark">{post.data.title}</h1>
      <p class="text-lg text-gray-600 mt-4">{post.data.description}</p>
    </header>

    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <!-- Share / CTA -->
    <div class="mt-12 pt-8 border-t border-gray-100 text-center">
      <p class="text-gray-500 mb-6">¿Te gustó este artículo? Comparte sonrisas.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://api.whatsapp.com/send?phone=573105367290&text=Hola%2C%20le%C3%AD%20un%20art%C3%ADculo%20en%20su%20blog%20y%20quer%C3%ADa%20consultarles" target="_blank" rel="noopener noreferrer" class="bg-primary hover:bg-primary-light text-white font-semibold px-8 py-3 rounded-full transition-all hover:scale-105">
          Agendar una Cita
        </a>
        <a href="/blog" class="border-2 border-primary text-primary font-semibold px-8 py-3 rounded-full hover:bg-primary hover:text-white transition-all hover:scale-105">
          Más Artículos
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
