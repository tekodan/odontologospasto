---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ContactInfo from '../components/ContactInfo.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.published);
  const services = await getCollection('services', ({ data }) => data.published);
  return [...pages, ...services].map(entry => ({
    params: { slug: entry.collection === 'pages' ? entry.id : `servicios/${entry.id}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isService = entry.collection === 'services';

const serviceImages: Record<string, string> = {
  'endodoncia': '/images/servicios/endodoncia.jpg',
  'periodoncia': '/images/servicios/periodoncia.jpeg',
  'estetica-dental': '/images/servicios/estetica-dental.jpeg',
  'rehabilitacion-oral': '/images/servicios/rehabilitacion-oral.jpeg',
  'cirugia-oral-y-maxilofacial': '/images/servicios/cirugia-oral-y-maxilofacial.jpg',
  'implantologia-dental': '/images/servicios/implantologia-dental.jpg',
  'ortodoncia': '/images/servicios/ortodoncia.jpg',
  'odontopediatria': '/images/servicios/odontopediatria.jpg',
  'estetica-orofacial': '/images/servicios/estetica-orofacial.jpg',
};
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  {isService && (
    <div class="h-48 md:h-64 overflow-hidden bg-gray-200">
      {serviceImages[entry.id] ? (
        <img src={serviceImages[entry.id]} alt={entry.data.title} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full bg-gradient-to-r from-primary to-primary-light flex items-center justify-center">
          <h1 class="text-3xl md:text-4xl font-bold text-white">{entry.data.title}</h1>
        </div>
      )}
    </div>
  )}
  <section class="bg-bg-light py-12 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-text-dark">{entry.data.title}</h1>
      {entry.data.description && <p class="text-gray-600 mt-2 text-lg">{entry.data.description}</p>}
    </div>
  </section>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </section>
  {entry.id === 'contacto' && (
    <section class="bg-white pb-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h2 class="text-2xl font-bold text-text-dark mb-6">Envíanos un mensaje</h2>
            <form action="https://formspree.io/f/tekodan%40gmail.com" method="POST" class="bg-bg-light rounded-xl p-8 space-y-4 shadow-sm">
              <div class="grid md:grid-cols-2 gap-4">
                <input type="text" name="nombre" placeholder="Nombres" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                <input type="text" name="apellido" placeholder="Apellidos" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
              </div>
              <input type="tel" name="telefono" placeholder="Teléfono" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
              <input type="email" name="email" placeholder="Correo Electrónico" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
              <textarea name="mensaje" placeholder="Motivo de Consulta" rows="4" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50"></textarea>
              <button type="submit" class="w-full bg-primary hover:bg-primary-light text-white font-semibold py-3 rounded-lg transition-colors">Enviar Mensaje</button>
            </form>
            <div class="mt-8 text-center md:text-left">
              <p class="text-gray-600 mb-4">O contáctanos directamente</p>
              <a href="https://api.whatsapp.com/send?phone=573105367290&text=Hola%2C%20quiero%20agendar%20una%20cita" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
                Escribenos por WhatsApp
              </a>
            </div>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-text-dark mb-6">Información de Contacto</h2>
            <div class="space-y-5 mb-8">
              <ContactInfo icon="map-pin" heading="Cra 34 #19-76" text="Pasto, Nariño - Colombia" href="https://maps.google.com/?q=Cra+34+19-76+Pasto+Nariño" />
              <ContactInfo icon="phone" heading="+57 310 536 7290" text="Llámanos o escríbenos por WhatsApp" href="tel:+573105367290" />
              <ContactInfo icon="mail" heading="guevaramarquezmaryllen071448@gmail.com" text="Escríbenos a nuestro correo electrónico" href="mailto:guevaramarquezmaryllen071448@gmail.com" />
              <ContactInfo icon="clock" heading="Lunes a Viernes 9:00 AM - 7:00 PM" text="Sábados 8:00 AM - 1:00 PM" />
            </div>
            <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100 mt-8">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.5!2d-77.2817!3d1.2249!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMcKwMTMnMjkuNiJOIDc3wrAxNic1NC4xIlc!5e0!3m2!1ses!2sco!4v1717000000000"
                width="100%"
                height="320"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Ubicación de la clínica"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
