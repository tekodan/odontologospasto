---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ContactInfo from '../components/ContactInfo.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => data.published);
  const services = await getCollection('services', ({ data }) => data.published);
  return [...pages, ...services].map(entry => ({
    params: { slug: entry.collection === 'pages' ? entry.id : `servicios/${entry.id}` },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isService = entry.collection === 'services';
const currentUrl = Astro.url.pathname;

const serviceImages: Record<string, string> = {
  'endodoncia': '/images/servicios/endodoncia.jpg',
  'periodoncia': '/images/servicios/periodoncia.jpeg',
  'estetica-dental': '/images/servicios/estetica-dental.jpeg',
  'rehabilitacion-oral': '/images/servicios/rehabilitacion-oral.jpeg',
  'cirugia-oral-y-maxilofacial': '/images/servicios/cirugia-oral-y-maxilofacial.jpg',
  'implantologia-dental': '/images/servicios/implantologia-dental.jpg',
  'ortodoncia': '/images/servicios/ortodoncia.jpg',
  'odontopediatria': '/images/servicios/odontopediatria.jpg',
  'estetica-orofacial': '/images/servicios/estetica-orofacial.jpg',
};

const servicesFaq: Record<string, Array<{question: string; answer: string}>> = {
  'endodoncia': [
    { question: '¿Cuántas sesiones necesita una endodoncia?', answer: 'La mayoría de endodoncias se completan en 1 o 2 sesiones, dependiendo de la complejidad del caso. En dientes con un solo conducto, generalmente basta con una sesión. La Dra. Maryllen, como especialista en endodoncia, evalúa cada caso para darte un plan de tratamiento preciso.' },
    { question: '¿Puedo conducir o trabajar después de una endodoncia?', answer: 'Sí. El procedimiento se realiza bajo anestesia local, por lo que puedes retomar tus actividades normales inmediatamente después. Es posible que sientas una leve molestia que se controla con analgésicos de venta libre, pero no afecta tu capacidad para conducir o trabajar.' },
    { question: '¿Es mejor hacer una endodoncia o extraer el diente?', answer: 'Siempre que sea posible, la endodoncia es la mejor opción. Conservar tu diente natural mantiene la función masticatoria, evita el desplazamiento de dientes vecinos y preserva la estructura ósea. La extracción solo se recomienda cuando el diente no puede salvarse.' },
  ],
  'periodoncia': [
    { question: '¿Qué tan dolorosa es una limpieza dental profunda?', answer: 'Bajo anestesia local, el raspado y alisado radicular es un procedimiento indoloro. Después del tratamiento puedes sentir una ligera sensibilidad que desaparece en pocos días.' },
    { question: '¿Cada cuánto debo hacerme una limpieza dental?', answer: 'Recomendamos una limpieza profesional cada 6 meses. Si tienes enfermedad periodontal, pueden ser necesarias visitas más frecuentes según la indicación de tu especialista.' },
  ],
  'estetica-dental': [
    { question: '¿El blanqueamiento dental causa sensibilidad?', answer: 'Puede causar sensibilidad temporal en algunos pacientes, que desaparece en 24 a 48 horas. Usamos geles con agentes desensibilizantes para minimizar esta molestia y hacemos un seguimiento personalizado.' },
    { question: '¿Cuánto duran las carillas dentales?', answer: 'Las carillas de cerámica tienen una duración de 15 a 20 años con el cuidado adecuado. Las de resina duran entre 5 y 7 años. La duración depende de tu higiene oral y de evitar hábitos como morder objetos duros.' },
  ],
  'rehabilitacion-oral': [
    { question: '¿Cuánto tiempo toma una rehabilitación oral?', answer: 'La duración varía según la complejidad del caso. Una rehabilitación simple puede tomar de 2 a 4 semanas, mientras que casos más extensos que involucran implantes pueden extenderse varios meses. Te daremos un cronograma detallado en tu primera consulta.' },
    { question: '¿Las prótesis fijas son mejores que las removibles?', answer: 'Las prótesis fijas ofrecen mayor comodidad, estabilidad y naturalidad, ya que van cementadas sobre dientes o implantes. Las removibles son una buena alternativa económica cuando no es posible colocar una fija. Evaluamos tu caso para recomendarte la mejor opción.' },
  ],
  'cirugia-oral-y-maxilofacial': [
    { question: '¿Cuánto duele una extracción de cordales?', answer: 'La extracción se realiza bajo anestesia local, por lo que no sentirás dolor durante la cirugía. Después del procedimiento, tendrás indicaciones y medicamentos para controlar la inflamación y el dolor, que disminuye significativamente a partir del tercer día.' },
    { question: '¿Cuánto tiempo tarda la recuperación de una bichectomía?', answer: 'La recuperación es rápida. La inflamación disminuye notablemente en 3 a 5 días, y puedes retomar tus actividades normales en 1 semana. Los resultados finales se aprecian a partir del primer mes.' },
  ],
  'implantologia-dental': [
    { question: '¿Duele colocarse un implante dental?', answer: 'La colocación del implante se realiza bajo anestesia local y es un procedimiento indoloro. Después de la cirugía, la molestia es similar a la de una extracción dental simple y se controla fácilmente con analgésicos recetados.' },
    { question: '¿Puedo comer normal con implantes dentales?', answer: 'Una vez finalizado el proceso de oseointegración y colocada la corona definitiva, puedes comer con total normalidad. Los implantes recuperan hasta el 98% de la capacidad masticatoria de un diente natural.' },
  ],
  'ortodoncia': [
    { question: '¿A qué edad puedo empezar un tratamiento de ortodoncia?', answer: 'La primera evaluación se recomienda a los 7 años para detectar problemas tempranos. Pero la ortodoncia no tiene límite de edad: cada vez más adultos mejoran su sonrisa con tratamientos actuales como Invisalign o brackets estéticos.' },
    { question: '¿Cuánto dura un tratamiento de ortodoncia?', answer: 'La duración promedio es de 18 a 24 meses, aunque varía según la complejidad del caso. Con Invisalign, algunos casos pueden resolverse en tan solo 6 a 12 meses. Durante tu evaluación te daremos un tiempo estimado exacto.' },
  ],
  'odontopediatria': [
    { question: '¿A qué edad debo traer a mi hijo por primera vez?', answer: 'Recomendamos la primera visita odontológica cuando aparece el primer diente de leche, alrededor de los 6 a 12 meses. Esto permite detectar problemas tempranos y crear una relación positiva con el odontólogo desde pequeño.' },
    { question: '¿Cómo ayudan a los niños con miedo al odontólogo?', answer: 'La Dra. Maryllen tiene una paciencia y calidez especial con los niños. Usamos técnicas de manejo de conducta positivo: explicamos cada paso con lenguaje infantil, usamos el refuerzo positivo y creamos un ambiente de confianza para que nunca salgan asustados.' },
  ],
  'estetica-orofacial': [
    { question: '¿Es seguro el ácido hialurónico?', answer: 'Sí. El ácido hialurónico es una sustancia biocompatible que se reabsorbe naturalmente con el tiempo. Utilizamos solo productos certificados y aplicamos protocolos de seguridad estrictos para garantizar resultados naturales y seguros.' },
    { question: '¿Cuánto duran los resultados de la toxina botulínica?', answer: 'Los resultados de la toxina botulínica duran aproximadamente de 4 a 6 meses. Con aplicaciones periódicas, los intervalos entre sesiones pueden alargarse porque los músculos se adaptan al tratamiento.' },
  ],
};
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <!-- Breadcrumb -->
  <div class="bg-bg-light border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
        {isService ? (
          <>
            <a href="/#servicios" class="hover:text-primary transition-colors">Servicios</a>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
            <span class="text-primary font-medium">{entry.data.title}</span>
          </>
        ) : (
          <span class="text-primary font-medium">{entry.data.title}</span>
        )}
      </nav>
    </div>
  </div>

  <!-- BreadcrumbList schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": isService ? [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://odontologospasto.com.co/" },
      { "@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://odontologospasto.com.co/#servicios" },
      { "@type": "ListItem", "position": 3, "name": entry.data.title, "item": `https://odontologospasto.com.co${currentUrl}` }
    ] : [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://odontologospasto.com.co/" },
      { "@type": "ListItem", "position": 2, "name": entry.data.title, "item": `https://odontologospasto.com.co${currentUrl}` }
    ]
  })} />

  {isService && (
    <div class="h-48 md:h-64 overflow-hidden bg-gray-200">
      {serviceImages[entry.id] ? (
        <img src={serviceImages[entry.id]} alt={entry.data.title} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full bg-gradient-to-r from-primary to-primary-light flex items-center justify-center">
          <h1 class="text-3xl md:text-4xl font-bold text-white">{entry.data.title}</h1>
        </div>
      )}
    </div>
  )}
  <section class="bg-bg-light py-12 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-text-dark">{entry.data.title}</h1>
      {entry.data.description && <p class="text-gray-600 mt-2 text-lg">{entry.data.description}</p>}
    </div>
  </section>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </section>

  <!-- FAQ per service -->
  {isService && servicesFaq[entry.id] && (
    <section class="bg-bg-light py-16">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-text-dark text-center mb-8">Preguntas Frecuentes sobre {entry.data.title}</h2>
        <div class="space-y-3" x-data="{ open: null }">
          {servicesFaq[entry.id].map((item, i) => (
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <button
                @click={`open = open === ${i} ? null : ${i}`}
                class="w-full flex items-center justify-between px-6 py-4 text-left hover:bg-gray-50 transition-colors"
              >
                <span class="font-semibold text-text-dark pr-4">{item.question}</span>
                <svg :class={`open === ${i} ? 'rotate-180' : ''`} class="w-5 h-5 text-primary flex-shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div
                x-show={`open === ${i}`}
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0 max-h-0"
                x-transition:enter-end="opacity-100 max-h-96"
                x-transition:leave="transition ease-in duration-200"
                x-transition:leave-start="opacity-100 max-h-96"
                x-transition:leave-end="opacity-0 max-h-0"
                class="overflow-hidden"
                x-cloak
              >
                <p class="px-6 pb-5 text-gray-600 leading-relaxed">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA WhatsApp for services -->
  {isService && (
    <section class="py-16 bg-primary text-white text-center">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">¿Interesado/a en {entry.data.title.toLowerCase()}?</h2>
        <p class="text-white/80 mb-8 text-lg">Contáctanos ahora para agendar una valoración sin costo con la Dra. Maryllen. Estamos listos para resolver tus dudas y crear el mejor plan de tratamiento para ti.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`https://api.whatsapp.com/send?phone=573105367290&text=Hola%2C%20estoy%20interesado%2Fa%20en%20${encodeURIComponent(entry.data.title.toLowerCase())}`} target="_blank" rel="noopener noreferrer" class="bg-white text-primary font-semibold px-8 py-3 rounded-full hover:bg-gray-100 transition-all hover:scale-105 inline-flex items-center gap-2">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  )}

  {entry.id === 'contacto' && (
    <>
      <!-- Badge de Urgencias -->
      <section class="py-10 bg-bg-light">
        <div class="max-w-2xl mx-auto px-4">
          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
            <div class="bg-primary px-6 py-4 flex items-center gap-3">
              <div class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center flex-shrink-0 ring-2 ring-white/30">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7-3 11-6 14-3-3-6-7-6-14"/><circle cx="12" cy="8" r="2"/></svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-white">¿Emergencia Dental?</h2>
                <p class="text-white/70 text-sm">Atención prioritaria el mismo día</p>
              </div>
            </div>
            <div class="px-6 py-5 text-center">
              <p class="text-gray-600 text-sm mb-4">Dolor intenso, fractura, inflamación. Contáctanos ahora.</p>
              <a href="https://api.whatsapp.com/send?phone=573105367290&text=Tengo%20una%20urgencia%20dental%2C%20necesito%20atenci%C3%B3n" target="_blank" rel="noopener noreferrer" class="bg-accent hover:bg-accent-light text-white font-semibold px-6 py-2.5 rounded-full transition-all hover:scale-105 inline-flex items-center gap-2 text-sm shadow-md">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Urgencia por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Formulario + Contacto -->
      <section class="bg-white pb-16 pt-12">
        <div class="max-w-6xl mx-auto px-4">
          <div class="grid md:grid-cols-2 gap-12">
            <div>
              <h2 class="text-2xl font-bold text-text-dark mb-6">Envíanos un mensaje</h2>
              <form action="https://formspree.io/f/guevaramarquezmaryllen071448%40gmail.com" method="POST" class="bg-bg-light rounded-xl p-8 space-y-4 shadow-sm">
                <div class="grid md:grid-cols-2 gap-4">
                  <input type="text" name="nombre" placeholder="Nombres" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                  <input type="text" name="apellido" placeholder="Apellidos" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                </div>
                <input type="tel" name="telefono" placeholder="Teléfono" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                <input type="email" name="email" placeholder="Correo Electrónico" required class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                <textarea name="mensaje" placeholder="Motivo de Consulta" rows="4" class="w-full border border-gray-200 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary/50"></textarea>
                <button type="submit" class="w-full bg-primary hover:bg-primary-light text-white font-semibold py-3 rounded-lg transition-colors">Enviar Mensaje</button>
              </form>
              <div class="mt-8 text-center md:text-left">
                <p class="text-gray-600 mb-4">O contáctanos directamente</p>
                <a href="https://api.whatsapp.com/send?phone=573105367290&text=Hola%2C%20quiero%20agendar%20una%20cita" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
                  Escribenos por WhatsApp
                </a>
              </div>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-text-dark mb-6">Información de Contacto</h2>
              <div class="space-y-5 mb-8">
                <ContactInfo icon="map-pin" heading="Cra 34 #19-76" text="Pasto, Nariño - Colombia" href="https://maps.google.com/?q=Cra+34+19-76+Pasto+Nariño" />
                <ContactInfo icon="phone" heading="+57 310 536 7290" text="Llámanos o escríbenos por WhatsApp" href="tel:+573105367290" />
                <ContactInfo icon="mail" heading="guevaramarquezmaryllen071448@gmail.com" text="Escríbenos a nuestro correo electrónico" href="mailto:guevaramarquezmaryllen071448@gmail.com" />
                <ContactInfo icon="clock" heading="Lunes a Viernes 9:00 AM - 7:00 PM" text="Sábados 8:00 AM - 1:00 PM" />
              </div>

              <!-- Horarios visuales -->
              <div class="bg-bg-light rounded-xl p-6 mb-8">
                <h3 class="font-semibold text-text-dark mb-3">Horarios de Atención</h3>
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Lunes a Viernes</span>
                    <span class="text-sm bg-primary/10 text-primary font-semibold px-3 py-1 rounded-full">9 AM — 7 PM</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Sábados</span>
                    <span class="text-sm bg-accent/20 text-accent font-semibold px-3 py-1 rounded-full">8 AM — 1 PM</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-700">Domingos</span>
                    <span class="text-sm bg-gray-200 text-gray-500 font-semibold px-3 py-1 rounded-full">Cerrado</span>
                  </div>
                </div>
              </div>

              <div class="rounded-xl overflow-hidden shadow-sm border border-gray-100">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.5!2d-77.2817!3d1.2249!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMcKwMTMnMjkuNiJOIDc3wrAxNic1NC4xIlc!5e0!3m2!1ses!2sco!4v1717000000000"
                  width="100%"
                  height="320"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Ubicación de la clínica"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>
    </>
  )}
