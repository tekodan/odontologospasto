---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog" description="Tips de salud oral, consejos de la Dra. Maryllen Guevara y más información para cuidar tu sonrisa.">
  <section class="bg-primary py-16 text-center text-white">
    <div class="max-w-4xl mx-auto px-4">
      <span class="text-sm font-semibold uppercase tracking-widest text-white/70" style="letter-spacing: 1.75px;">Aprende de Salud Oral</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mt-2 text-white">Blog Odontológico</h1>
      <p class="text-white/80 mt-4 max-w-2xl mx-auto">Tips, consejos y artículos escritos por la Dra. Maryllen Guevara Márquez para ayudarte a cuidar tu sonrisa y la de tu familia.</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <div class="bg-bg-light border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-3">
      <nav class="flex items-center gap-2 text-sm text-gray-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Inicio</a>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-primary font-medium">Blog</span>
      </nav>
    </div>
  </div>

  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-8">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="bg-white rounded-xl shadow-sm hover:shadow-lg border border-gray-100 hover:border-primary/20 transition-all group overflow-hidden hover:-translate-y-1">
            <div class="aspect-[16/9] overflow-hidden bg-gray-100">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              ) : (
                <div class="w-full h-full bg-gradient-to-r from-primary to-primary-light flex items-center justify-center">
                  <svg class="w-16 h-16 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
              )}
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                <span>{post.data.author}</span>
                <span>·</span>
                <span>{post.data.date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
              <h2 class="text-xl font-bold text-text-dark mb-2 group-hover:text-primary transition-colors line-clamp-2">{post.data.title}</h2>
              <p class="text-gray-600 line-clamp-3">{post.data.description}</p>
              <span class="inline-block mt-4 text-sm font-semibold text-primary group-hover:text-primary-light transition-colors">Leer más →</span>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20 text-gray-400">
          <p class="text-lg">Pronto publicaremos artículos para ti.</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-primary text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">¿Tienes una pregunta que no encuentras aquí?</h2>
      <p class="text-white/80 mb-8">La Dra. Maryllen está feliz de resolver todas tus dudas sobre salud oral.</p>
      <a href="https://api.whatsapp.com/send?phone=573105367290&text=Hola%2C%20tengo%20una%20consulta%20sobre%20salud%20oral" target="_blank" rel="noopener noreferrer" class="bg-white text-primary font-semibold px-8 py-3 rounded-full hover:bg-gray-100 transition-all hover:scale-105 inline-flex items-center gap-2">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        Consultar por WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
